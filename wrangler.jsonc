{
  "name": "clarity-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "clarity-*.workers.dev/*",
      "zone_name": "workers.dev"
    }
  ],
  "site": {
    "bucket": "./dist"
  }
}
