# Flask
FLASK_SECRET=                   # Required: generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0                  # Set to 1 for local development only

# Session
SESSION_COOKIE_SECURE=1        # Set to 1 in production (requires HTTPS)

# Database (optional - defaults to server/data/nexus.db)
# DATABASE_PATH=/persistent/clarity/clarity.db

# File uploads (optional - defaults to server/uploads)
# UPLOAD_DIR=/persistent/clarity/uploads

# Model API Keys (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Optional: pre-configured models as JSON
# MODELS_CONFIG=[{"id":"my-model","name":"My Model","provider":"openai","apiKey":"sk-...","modelName":"gpt-4o"}]
